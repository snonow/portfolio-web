# Vite fingerprints everything under /assets/ — the URL changes with the content.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Profile photo variants (Hero.jsx, og:image): stable names, so a shorter cache.
/profile.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/profile-224.avif
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/profile-416.avif
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/profile-224.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/profile-416.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
