% ■ Section heading with a rule underneath
\newcommand{\jsec}[1]{%
  \par\vspace{6pt}%
  {\large\bfseries\color{accent}■\,#1}\par\vspace{1pt}%
  {\color{accent}\hrule height 0.6pt}\vspace{5pt}%
}
% ◆ Company line: name on the left, period on the right
\newcommand{\jcompany}[2]{\par\vspace{4pt}{\bfseries ◆\,#1}\hfill{\small #2}\par}
\newcommand{\jnote}[1]{{\small\color{black!65}#1}\par\vspace{2pt}}

